#!/bin/sh
set -eu

layout_name="${TERMINATOR_AUTO_SESSION_LAYOUT:-TerminatorAutoSessionRestore}"
config_home="${XDG_CONFIG_HOME:-"$HOME/.config"}"
config_file="$config_home/terminator/config"
force_restore="${TERMINATOR_FORCE_AUTO_RESTORE:-}"

run_plain() {
  exec /usr/bin/terminator "$@"
}

saved_layout_has_terminal() {
  awk -v layout_name="$layout_name" '
    /^[[:space:]]*\[\[[^[]/ {
      in_layout = ($0 ~ "^[[:space:]]*\\[\\[" layout_name "\\]\\][[:space:]]*$")
    }
    in_layout && /^[[:space:]]*type[[:space:]]*=[[:space:]]*Terminal[[:space:]]*$/ {
      found = 1
    }
    END {
      exit(found ? 0 : 1)
    }
  ' "$config_file"
}

if [ "${TERMINATOR_NO_AUTO_RESTORE:-}" = "1" ]; then
  run_plain "$@"
fi

if [ "$#" -ne 0 ]; then
  run_plain "$@"
fi

if [ "$force_restore" != "1" ] &&
   pgrep -u "$(id -u)" -f '(^|[ /])terminator([ ]|$)' >/dev/null 2>&1; then
  run_plain "$@"
fi

if [ -r "$config_file" ] && saved_layout_has_terminal; then
  if [ "$force_restore" = "1" ]; then
    exec /usr/bin/terminator -u -l "$layout_name"
  fi
  exec /usr/bin/terminator -l "$layout_name"
fi

run_plain "$@"
